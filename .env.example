# ==========================================
# BASE DE DONNÉES POSTGRESQL (PRISMA)
# ==========================================
# Mode transaction partagé (utilisé par Prisma Client pour les requêtes)
DATABASE_URL="postgresql://postgres:password@localhost:5432/passpayback?schema=public"

# Mode session direct (utilisé pour les migrations Prisma)
DIRECT_URL="postgresql://postgres:password@localhost:5432/passpayback?schema=public"

# ==========================================
# AUTHENTIFICATION SUPABASE
# ==========================================
SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_KEY="votre_cle_supabase_service_role_ou_anon"

# ==========================================
# PASSERELLE DE PAIEMENT MAISHAPAY
# ==========================================
# Clés fournies par votre tableau de bord marchand MaishaPay
MAISHAPAY_API_KEY=""
MAISHAPAY_SECRET_KEY=""
MAISHAPAY_MERCHANT_KEY=""

# Environnement : 'sandbox' ou 'production'
MAISHAPAY_ENV="sandbox"

# URL de base de l'API (optionnel, utilise par défaut l'URL officielle)
# MAISHAPAY_BASE_URL="https://api.maishapay.online/api/v1"

# URL publique de notification (Webhook / IPN)
MAISHAPAY_CALLBACK_URL="https://api.votredomaine.com/maishapay/webhook"
MAISHAPAY_RETURN_URL="https://app.votredomaine.com/wallet"

# ==========================================
# APPLICATION SERVEUR
# ==========================================
PORT=3000
NODE_ENV="development"
